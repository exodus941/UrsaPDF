<?xml version="1.0" encoding="utf-8"?>
<!-- Tabler Icons "toggle-left" (MIT) with its knob in a group, sliding to the
     "toggle-right" position (x 8 to 16) over 250 ms, ease-out. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="24dp"
            android:height="24dp"
            android:viewportWidth="24"
            android:viewportHeight="24">
            <path
                android:pathData="M2 6m0 6a6 6 0 0 1 6 -6h8a6 6 0 0 1 6 6v0a6 6 0 0 1 -6 6h-8a6 6 0 0 1 -6 -6z"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="2"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <group android:name="knob">
                <path
                    android:pathData="M8 12m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"
                    android:strokeColor="#FFFFFFFF"
                    android:strokeWidth="2"
                    android:strokeLineCap="round"
                    android:strokeLineJoin="round" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="knob">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="translateX"
                android:valueFrom="0"
                android:valueTo="8"
                android:duration="250"
                android:interpolator="@android:interpolator/linear_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
